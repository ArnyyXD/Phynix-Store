datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Auth (NextAuth) ---
// NextAuth's Prisma adapter expects models named exactly User, Account,
// Session, VerificationToken. Our marketplace listings are a *separate*
// model called GameAccount, further down, so the names don't collide.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  image         String?
  createdAt     DateTime  @default(now())

  // "unverified" | "pending" | "verified" -- set once a seller completes
  // KYC (original account email or government ID, checked outside the
  // database -- see the note on OtpCode/KYC below and the privacy policy).
  kycStatus String @default("unverified")

  accounts Account[] // OAuth links (Google etc.) — NextAuth's own table
  sessions Session[]

  listings GameAccount[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One-time codes for phone sign-in (India phone numbers).
// In production, swap the "send" step for a real SMS provider (MSG91,
// 2Factor, Twilio) — see app/api/otp/send/route.js.
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

// --- Marketplace ---

model GameAccount {
  id             String   @id @default(cuid())
  sellerId       String
  game           String // "valorant" | "clash_of_clans" | "bgmi"
  title          String
  rank           String // Valorant rank / BGMI tier / CoC Town Hall level
  level          Int? // account level or XP, where applicable
  skinNames      String[] // skins, notable items, or maxed heroes/troops
  agentsUnlocked String?
  region         String   @default("India")
  listingType    String // "buy" | "rent" | "emi"
  price          Int // estimated price in INR
  rentPeriodDays Int?
  emiMonths      Int?
  description    String?

  // pending: awaiting review, live: visible in /buy, sold: no longer available,
  // rejected: failed review
  status   String  @default("pending")
  verified Boolean @default(false)

  createdAt DateTime @default(now())

  seller User @relation(fields: [sellerId], references: [id])
}
